#!/usr/bin/env python3
"""
Pre-commit guard: blocks a commit if any staged file contains something
that looks like a live secret (Telegram bot token, GitHub PAT/token,
Supabase service-role secret key).

Why this exists: on 2026-09-01 a Telegram bot token and a GitHub PAT were
committed in the clear into this (at the time public) repo and ended up
abused. Secrets belong only in Railway environment variables, never in
tracked files.
"""
import re
import subprocess
import sys

PATTERNS = [
    (r"\b\d{8,10}:[A-Za-z0-9_-]{35}\b", "Telegram bot token"),
    (r"\bghp_[A-Za-z0-9]{36}\b", "GitHub token (classic PAT)"),
    (r"\bgithub_pat_[A-Za-z0-9_]{20,}\b", "GitHub fine-grained PAT"),
    (r"\bsb_secret_[A-Za-z0-9_-]{20,}\b", "Supabase secret key"),
]

# Files that are allowed to mention what a secret pattern looks like
# (docs/examples), without containing a real one.
ALLOWLIST = {".githooks/pre-commit"}


def staged_files():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    )
    return [f for f in out.stdout.splitlines() if f]


def staged_content(path):
    out = subprocess.run(
        ["git", "show", f":{path}"],
        capture_output=True, text=True, errors="replace",
    )
    return out.stdout


def main():
    found = False
    for path in staged_files():
        if path in ALLOWLIST:
            continue
        text = staged_content(path)
        for pattern, label in PATTERNS:
            m = re.search(pattern, text)
            if m:
                print(f"BLOCKED: {path} looks like it contains a {label}: {m.group()[:12]}...")
                found = True
    if found:
        print("\nRemove the secret and read it from an environment variable instead.")
        print("If this is a false positive, add the file to ALLOWLIST in .githooks/pre-commit.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
